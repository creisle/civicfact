rule generate_explanation_prompts:
    input: 'data/{dataset}-{data_version}/data.jsonl.gz'
    output: 'results/explanations/{dataset}-{data_version}/f{subsample}_s{random_seed}/prompts.jsonl.gz'
    shell: ACTIVATE_PYTHON + ' python src/api/create_explanation_prompts.py {input} {output} --random_seed {wildcards.random_seed} --subsample {wildcards.subsample}'


rule evaluate_explanation_prompts:
    input: 'results/explanations/{dataset}-{data_version}/f{subsample}_s{random_seed}/prompts.jsonl.gz'
    output: 'results/explanations/{dataset}-{data_version}/f{subsample}_s{random_seed}/{model_dir}/gen-{generation_config}/prompts.jsonl.gz'
    wildcard_constraints:
        data=r"[^/]+",
    resources:
        gpus=0
    params:
        model_name=lambda w: w.model_dir.split('__')[1],
        api_key_var=lambda w: 'GEMINI_API_KEY' if w.model_dir.startswith('google__') else 'OPENAI_API_KEY'
    shell: ACTIVATE_PYTHON + ' python src/api/openai_eval.py {input} {output} --batch_mode --model {params.model_name} --generation_config configs/generation/config-{wildcards.generation_config}.json --api_key_var {params.api_key_var} '


rule add_explanations_to_data:
    input: explanations='results/explanations/civicfact-{data_version}/f{subsample}_s42/openai__gpt-5.2/gen-{generation_config}/prompts.jsonl.gz',
        data='data/{dataset}-{data_version}/data.jsonl.gz'
    output: 'data/{dataset}xf{subsample}g{generation_config}-{data_version}/data.jsonl.gz'
    shell: ACTIVATE_PYTHON + ' python src/add_explanations_to_dataset.py {input.data} {input.explanations} {output}'
