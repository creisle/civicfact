rule fetch_pubtator_for_civic_descriptions:
    input: rules.augment_civic_disease_aliases.output
    output: rules.augment_civic_disease_aliases.output[0].replace('.jsonl', '.pubtator-descriptions.jsonl')
    params:
        db=lambda w: config['DB_FILE']
    shell: PYTHON + ' -m pubtator.api {input} {output} --article_db_file {params.db} \
'


rule fetch_pubtator_annotations:
    input: rules.augment_civic_disease_aliases.output
    output: 'results/civic/pubtator_annotations.jsonl.gz'
    shell: PYTHON + ' -m pubtator.fetch {input} {output}'


rule split_pubtator_annotations:
    input: rules.fetch_pubtator_annotations.output
    output: expand('results/civic/pubtator_annotations.subset-{subset}.jsonl', subset=range(config['PUBTATOR_SPLIT']))
    run:
        import pandas as pd
        from article_utils.util import dump_jsonl

        df = pd.read_json(input[0], lines=True, dtype=False)
        n_rows = int(round(df.shape[0] / config['PUBTATOR_SPLIT']))
        chunks = [df[i:i+n_rows] for i in range(0,df.shape[0],n_rows)]
        for subset_i, chunk_df in enumerate(chunks):
            dump_jsonl(chunk_df, f'results/civic/pubtator_annotations.subset-{subset_i}.jsonl')



rule match_pubtator_annotations:
    input: rules.upload_author_manuscript_listing.output, data='results/civic/pubtator_annotations.subset-{subset}.jsonl'
    output: main='results/civic/pubtator_annotations.subset-{subset}.fulltext-matched.jsonl',
        matches='results/civic/pubtator_annotations.subset-{subset}.matches.jsonl'
    params:
        db=lambda w: config['DB_FILE']
    shell: PYTHON + ''' src/match_to_fulltext.py \
        {input.data} \
        {output.main} \
        --article_db_file {params.db} \
        --match_output {output.matches}
        '''

rule collect_pubtator_annotations:
    input: expand(rules.match_pubtator_annotations.output.main, subset=range(config['PUBTATOR_SPLIT'])),
    output: 'results/civic/pubtator_annotations.fulltext-matched.jsonl'
    shell: 'cat {input} > {output}'

rule upload_pubtotor_matches:
    input: expand(rules.match_pubtator_annotations.output.matches,  subset=range(config['PUBTATOR_SPLIT']))
    output: touch('results/civic/pubtator_matches.UPLOADED')
    params:
        db=lambda w: config['DB_FILE']
    shell: PYTHON + ' -m article_utils.match_text {input} --db_file {params.db}'


rule postprocess_pubtator_annotations:
    input: annotations=rules.collect_pubtator_annotations.output,
        do=rules.process_do.output,
        cells=rules.process_cells.output
    output:'results/civic/pubtator_annotations.fulltext-matched.filtered.jsonl'
    shell: PYTHON + ' -m pubtator.postprocess {input.annotations} --disease_ontology {input.do} {output} --cells {input.cells}'


rule parse_acronyms:
    input: data=rules.augment_civic_disease_aliases.output,
        listing=rules.upload_author_manuscript_listing.output,
        genes=rules.download_ncbi_gene.output
    output: multiext('results/civic/acronyms','.jsonl', '.errors.jsonl')
    params:
        db=lambda w: config['DB_FILE']
    shell: PYTHON + ''' -m article_utils.acronyms \
        {output} \
        --article_db_file {params.db} \
        --civic {input.data} \
        --genes {input.genes}
        '''


rule extract_description_examples:
    input: main=rules.fetch_pubtator_for_civic_descriptions.output,
        do=rules.process_do.output,
        clo=rules.process_cells.output,
        acronyms=rules.parse_acronyms.output[0],
    output:  rules.fetch_pubtator_for_civic_descriptions.output[0].replace('.jsonl', '.descriptions.build.jsonl')
    shell: PYTHON + '''\
         -m civic.extract_descriptions \
         {input.main} {output} \
         --do {input.do} \
         --clo {input.clo} \
         --acronyms {input.acronyms}'''


rule download_hypothesis:
    output: 'data/hypothesis-dump.{group_id}.jsonl'
    shell: PYTHON + ' -m hypothesis.download {wildcards.group_id} {output}'


rule parse_hypothesis_annotations:
    input: data=rules.download_hypothesis.output,
        civic=rules.augment_civic_disease_aliases.output,
        author=rules.parse_acronyms.output
    params:
        db=lambda w: config['DB_FILE'],
        neutral=lambda w: '--neutral' if w.group_id == GROUP_ID_MAPPING['neutral'] else ''
    output: config['OUTPUT_DIR'] + '/hypothesis-dump.{group_id}.parsed.jsonl'
    shell: PYTHON + ''' -m hypothesis.parse \
        {input.data} \
        {output} \
        --civic_dump {input.civic} \
        --article_db_file {params.db} {params.neutral} \
        --min_user_selections ''' + str(config['MIN_USER_SELECTIONS'])


rule match_hypothesis_annotations:
    input: data=rules.parse_hypothesis_annotations.output
    output: main=rules.parse_hypothesis_annotations.output[0].replace('.jsonl', '.fulltext-matched.jsonl'),
        matches=rules.parse_hypothesis_annotations.output[0].replace('.jsonl', '.matches.jsonl')
    params:
        db=lambda w: config['DB_FILE']
    shell: PYTHON + ''' src/match_to_fulltext.py \
        {input.data} \
        {output.main} \
        --article_db_file {params.db} \
        --match_output {output.matches}
        '''


rule upload_text_matches:
