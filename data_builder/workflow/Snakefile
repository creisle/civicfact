configfile: 'workflow/config.json'


def get_backup_file_name(w, output):
    result = []
    assert len(output) == 1
    for filename in output:
        result.append(re.sub(r'(\.[^.]+)$', r'.backup\1', filename))
    return result

envvars:
    "HYPOTHESIS_API_KEY"

PYTHON = 'source .venv/bin/activate; python '

GROUP_ID_MAPPING = config["GROUP_ID_MAPPING"]

PARTITIONING_FILE = 'results/civic_nli/partitioning.csv'

FINAL_FILES = [
    os.path.join(config['OUTPUT_DIR'], 'partitioning.csv'),
