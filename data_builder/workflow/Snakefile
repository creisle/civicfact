rule init_db:
    output: config['DB_FILE'] + '.INIT'
    shell: PYTHON + ' -m article_utils.db ' + config['DB_FILE']


rule download_historical_ocr:
    output: directory('data/pmc/historical_ocr')
    params:
        url='https://ftp.ncbi.nlm.nih.gov/pub/pmc/historical_ocr'
    shell: '''\
        mkdir -p {output};
        cd {output};
        wget {params.url} -O index.html;
        for x in $( grep -P '[^<>"]+tar.gz' -o index.html | sort | uniq );
        do
            echo $x;
            wget {params.url}/$x -O $x;
            tar -tf $x | grep .txt >> listing.txt;
        done'''


rule initialize_author_manuscript_listing:
    input:
        db=rules.init_db.output,
        ocr=rules.download_historical_ocr.output  # make sure you have the ocr listing setup
    params:
        db=lambda w: config['DB_FILE']
    output: 'data/pmc/author_manuscripts/listing.jsonl'
    shell: PYTHON + ' -m article_utils.author_manuscripts create {output}'


rule download_civic:
    output: config['CIVIC_DUMP']
    shell: f'{PYTHON} src/civic/download.py'


rule upload_author_manuscript_listing:
    input: rules.initialize_author_manuscript_listing.output,
        rules.download_civic.output
    params:
        db=lambda w: config['DB_FILE']
    output: touch('data/pmc/author_manuscripts/listing.jsonl.UPLOADED')
    shell: PYTHON + ' -m article_utils.author_manuscripts upload {params.db} {input}'


rule download_ncit_neoplasms:
    output: 'data/ncit/Neoplasm_Core.txt'
    shell: 'mkdir -p data/ncit; cd data/ncit; wget https://evs.nci.nih.gov/ftp1/NCI_Thesaurus/Neoplasm/Neoplasm_Core.txt'


rule download_disease_ontology:
    output: 'data/disease_ontology/doid.json'
    shell: '''\
        mkdir -p data/disease_ontology;
        cd data/disease_ontology;
        wget https://github.com/DiseaseOntology/HumanDiseaseOntology/raw/main/src/ontology/releases/doid.json
        '''


rule download_hpo:
    output: 'data/hpo/hp-base.json'
    shell: 'mkdir -p data/hpo; cd data/hpo; wget https://github.com/obophenotype/human-phenotype-ontology/releases/download/v2024-02-08/hp-base.json'


rule download_clo:
    output: 'data/cells/clo.owl'
    shell: 'mkdir -p data/cells; cd data/cells; wget http://purl.obolibrary.org/obo/clo.owl'


rule download_cellosaurus:
    output: 'data/cells/cellosaurus.obo'
    shell: 'mkdir -p data/cells; cd data/cells; wget https://ftp.expasy.org/databases/cellosaurus/cellosaurus.obo'


rule download_ncbi_gene:
    output: 'data/Homo_sapiens.gene_info.gz'
    shell: 'cd data; wget https://ftp.ncbi.nih.gov/gene/DATA/GENE_INFO/Mammalia/Homo_sapiens.gene_info.gz'


rule download_ncit:
    output: 'data/ncit/Thesaurus.txt'
    shell: '''\
        mkdir -p data/ncit;
        cd data/ncit;
        wget https://evs.nci.nih.gov/ftp1/NCI_Thesaurus/Thesaurus.FLAT.zip
        unzip Thesaurus.FLAT.zip
        rm *.zip*
        '''


rule preprocess_ncit:
    output: 'data/ncit/Thesaurus.jsonl'
    input: rules.download_ncit.output
    shell: PYTHON + 'src/preprocessing/simplify_ncit.py {input} {output}'


rule prepreprocess_cellosaurus:
    output: 'data/cells/cellosaurus.jsonl'
    input: rules.download_cellosaurus.output
    run:
        import obonet

        from article_utils.util import dump_jsonl

        graph = obonet.read_obo(input[0])
        df = pd.DataFrame.from_records(
            [{'id': node_id, **data} for node_id, data in graph.nodes(data=True)]
        )
        dump_jsonl(df, output[0])


rule process_cells:
    input: clo=rules.download_clo.output,
        cellosaurus=rules.prepreprocess_cellosaurus.output,
        ncit=rules.preprocess_ncit.output
    output: 'data/cells/cells.jsonl'
    shell: PYTHON + '''src/preprocessing/simplify_cells.py \
        --clo {input.clo} \
        --cellosaurus {input.cellosaurus} \
        --ncit {input.ncit} \
        {output}'''


rule process_do:
    input: do=rules.download_disease_ontology.output,
        ncit=rules.preprocess_ncit.output
    output: 'data/disease_ontology/doid.simple.jsonl'
    shell: PYTHON + ' src/preprocessing/simplify_do.py {input.do} {input.ncit} {output}'


rule process_hpo:
    input: rules.download_hpo.output
    output: 'data/hpo/hpo.simple.csv'
    shell: PYTHON + ' src/preprocessing/simplify_hpo.py {input} {output}'


