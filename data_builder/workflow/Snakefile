rule build_dataset:
    input: data=rules.match_hypothesis_annotations.output.main,
        civic_dump=rules.augment_civic_disease_aliases.output
    output: rules.match_hypothesis_annotations.output.main.replace('.jsonl', '.build.jsonl.gz')
    params:
        args=lambda w: '--neutral' if w.group_id == GROUP_ID_MAPPING['neutral'] else ''
    shell: PYTHON + ''' -m nli.build_dataset \
        {input.data} {output} \
        --civic_dump {input.civic_dump} \
        {params.args}
        '''

rule output_sentence_level_evidence:
    input: 'results/civic_nli/hypothesis-dump.JRwd19vg.parsed.fulltext-matched.build.jsonl.gz'
    output: 'results/civic_nli/sentence_level_evidence.jsonl.gz'
    shell: PYTHON + ' src/generate_passage_retrieval_dataset_form.py {input} {output}'


def get_merge_inputs():
    inputs = expand(rules.build_dataset.output, group_id=list(GROUP_ID_MAPPING.values()))
    inputs.extend(rules.extract_description_examples.output)
    return inputs


rule merge_annotation_sets:
    input: get_merge_inputs(),
    output: os.path.join(config['OUTPUT_DIR'], 'merged.jsonl.gz')
    params:
        int_output=lambda w, output: output[0].replace('.jsonl.gz', '.jsonl')
    shell: 'zcat {input} > {params.int_output}; gzip {params.int_output}'


rule simulate_errors_disease_specificity:
    input: main=rules.merge_annotation_sets.output,
        do=rules.process_do.output
    output: rules.merge_annotation_sets.output[0].replace('.jsonl.gz', '.dis_spec.jsonl.gz')
    shell: PYTHON + 'src/nli/simulate_errors_disease_specificity.py {input.main} {output} --do {input.do}'


rule simulate_errors_drug_specificity:
    input: main=rules.simulate_errors_disease_specificity.output,
        ncit=rules.preprocess_ncit.output,
        civic=rules.augment_civic_disease_aliases.output
    output: rules.simulate_errors_disease_specificity.output[0].replace('.jsonl.gz', '.drug_spec.jsonl.gz')
    shell: PYTHON + 'src/nli/simulate_errors_drug_specificity.py {input.main} {output} --ncit {input.ncit} --civic_dump {input.civic}'


rule simulate_errors_mutation_positions:
    input: rules.simulate_errors_drug_specificity.output
    output: rules.simulate_errors_drug_specificity.output[0].replace('.jsonl', '.mutate.jsonl')
    shell: PYTHON + 'src/nli/simulate_errors_mutations.py {input} {output}'



rule simulate_errors_flip_significance:
    input: rules.simulate_errors_mutation_positions.output
    output: rules.simulate_errors_mutation_positions.output[0].replace('.jsonl', '.flipped.jsonl')
    params:
        db=lambda w: config['DB_FILE'],
    shell: PYTHON + ''' -m nli.simulate_errors_flip_significance {input} {output}'''



rule partition_pubmed_articles:
    input: rules.upload_author_manuscript_listing.output,
        civic=rules.process_civic_revisions.output,
        annotations=rules.merge_annotation_sets.output
    output: PARTITIONING_FILE
    params:
        db=lambda w: config['DB_FILE']
    shell: PYTHON + f''' -m nli.assign_pubmed_to_partition \
        --article_db_file {{params.db}} \
        --civic_dump {{input.civic}} \
        --annotations {{input.annotations}} \
        {{output}} \
        --dev_percent {config["DEV_PERCENT"]} \
        --test_percent {config["TEST_PERCENT"]}
        '''


rule chunk_documents:
    input: civic_dump=rules.augment_civic_disease_aliases.output,
        acronyms=rules.parse_acronyms.output[0],
        partitions=PARTITIONING_FILE,
        pubtator=rules.postprocess_pubtator_annotations.output
    output: 'results/sentence_similarity/document_chunks.jsonl.gz'
    params:
        db=lambda w: config['DB_FILE']
    shell: PYTHON + f''' src/sentence_pairs/generate_document_chunks.py \
        --output {{output}} \
        --article_db_file {{params.db}} \
        --civic_dump {{input.civic_dump}} \
        --acronyms {{input.acronyms}} \
        --chunk_size {config["CHUNK_SIZE"]} \
        --chunk_overlap {config["CHUNK_OVERLAP"]} \
        --pubtator {{input.pubtator}} \
        --partitions {{input.partitions}}'''


rule set_labels_and_reasoning:
    input: data=rules.simulate_errors_flip_significance.output,
        civic=rules.augment_civic_disease_aliases.output
    output: rules.simulate_errors_flip_significance.output[0].replace('.jsonl', '.labels.jsonl')
    shell: PYTHON + f''' -m nli.set_labels_and_reasoning \
        {{input.data}} \
        --civic_dump {{input.civic}} \
        {{output}}
        '''


rule score_chunks:
    input: document_chunks=rules.chunk_documents.output,
        claims=rules.generate_civic_claims.output
    output: 'results/civic_nli/similarity_scores.jsonl.gz'
    shell: PYTHON + f''' -m sentence_pairs.score_sentence_pairs \
        {{input.claims}} \
        --document_chunks {{input.document_chunks}} \
        {{output}}
        '''


rule compare_pmids:
    input: data=rules.set_labels_and_reasoning.output,
        chunks=rules.chunk_documents.output
    output: 'results/civic_nli/disimilar_pmids.json'
    shell: PYTHON + ''' -m nli.compare_pmids {input.data} {input.chunks} {output}'''


rule simulate_errors_random_evidence_swap:
    input: data=rules.set_labels_and_reasoning.output,
        pmids=rules.compare_pmids.output,
        partitioning=PARTITIONING_FILE,
        chunks=rules.chunk_documents.output,
        scores=rules.score_chunks.output
    output: rules.set_labels_and_reasoning.output[0].replace('.jsonl', '.random-swap.jsonl')
    shell: PYTHON + ''' -m nli.simulate_errors_random_evidence_swap \
        {input.data} \
        --disimilar_pmids {input.pmids} \
        --scores {input.scores} \
        --document_chunks {input.chunks} \
        {output} \
        --partitioning {input.partitioning}'''


rule balance_dataset:
    input: data=rules.simulate_errors_random_evidence_swap.output,
        partitioning=PARTITIONING_FILE
    wildcard_constraints:
        goal_factor=r'((\d+(\.\d+)?)|max)'
    output: 'results/civic_nli/data.goal-{goal_factor}.jsonl.gz'
    params:
        flags=lambda w: '' if w.goal_factor == 'max' else f' --maximization_factor {w.goal_factor}'
    shell: PYTHON + f''' -m nli.balance_dataset \
        {{input.data}} \
        {{output}} \
        --sampling_iterations 100 \
        --partitioning {{input.partitioning}} {{params.flags}}
        '''
